# Optional overrides for power users. Copy to app/.env and fill in what you need.
# Everything here can also be set on the Settings page; values set here are read-only there.
# app/.env is gitignored and never committed.

# Spotify developer app Client ID (no client secret needed)
RIP_SPOTIFY_CLIENT_ID=

# Anthropic (paid) and Google Gemini (free tier) keys and models
RIP_ANTHROPIC_API_KEY=
RIP_ANTHROPIC_MODEL=
RIP_GEMINI_API_KEY=
RIP_GEMINI_MODEL=

# Only if the app runs somewhere other than http://127.0.0.1:3000.
# Must match a redirect URI registered in your Spotify app exactly.
# NUXT_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
